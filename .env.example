# Copy to .env at the repo root. Apps load this file automatically (dotenv).

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tsflux

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# apps/api
PORT=3000
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# apps/relay
RELAY_HEALTH_PORT=3002

# apps/worker
WORKER_PORT=3001

# packages/workflows activities
# "fake" = deterministic local provisioning, "http" = call PROVISIONING_API_URL
PROVISIONING_MODE=fake
PROVISIONING_API_URL=
